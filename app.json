{
  "expo": {
    "name": "Daricefy",
    "slug": "daricefy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daricefy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.daricefy.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCraVvDcuo9zsXoFD1xESee54_BgOAsOrU"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Daricefy necesita tu ubicación para mostrarte grupos cerca de donde estás.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Daricefy necesita tu ubicación en todo momento para actualizar tu posición en el mapa aunque la app esté en segundo plano.",
        "NSLocationAlwaysUsageDescription": "Daricefy necesita tu ubicación en segundo plano para compartir tu posición con el mapa del admin.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.daricefy.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDsYYbmFWAaCX1DtDTjO-ru4v8LiPkAXrk"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "READ_MEDIA_IMAGES",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Daricefy necesita tu ubicación para mostrarte grupos cerca y aparecer en el mapa del admin.",
          "locationAlwaysPermission": "Daricefy necesita tu ubicación en todo momento para actualizar tu posición en el mapa aunque la app esté en segundo plano.",
          "locationWhenInUsePermission": "Daricefy necesita tu ubicación para mostrarte grupos cerca de donde estás.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-task-manager"
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#000000"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.daricefy",
          "enableGooglePay": false
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00E676",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-localization",
      "expo-web-browser",
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "aa4ba397-7ebc-494d-bde2-a812cc48eca8"
      }
    },
    "owner": "danielrivera10"
  }
}
